# Copy to backend\.env and fill in. Never commit the real file.
# Generate secrets (PowerShell, from backend\):
#   .\.venv\Scripts\python.exe -c "import secrets;print(secrets.token_urlsafe(48))"            -> JWT_SECRET
#   .\.venv\Scripts\python.exe -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())" -> MASTER_ENCRYPTION_KEY

APP_ENV=development                 # development | test | production
HOST=127.0.0.1
PORT=8000

DATABASE_URL=postgresql+psycopg://gbp_app:CHANGE_ME@127.0.0.1:5432/gbp
TEST_DATABASE_URL=postgresql+psycopg://gbp_app:CHANGE_ME@127.0.0.1:5432/gbp_test

JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
MASTER_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_IDLE_MINUTES=120
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
COOKIE_SECURE=false                 # must be true in production (HTTPS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORAGE_DIR=../storage
MAX_UPLOAD_MB=25

WORKER_ENABLED=true
SCHEDULER_ENABLED=true
WORKER_CONCURRENCY=4
JOB_TIMEOUT_SECONDS=900
JOB_STALE_SECONDS=300

ALLOW_DEMO=true                     # set false in production to disable the Demo Bank Simulator

# Optional provider credentials (integration status: implemented, unverified)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                   # sandbox | production
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# India — RBI Account Aggregator via Setu AA Gateway (integration status: implemented, unverified)
# Obtain these after registering as an FIU product on Setu Bridge (https://bridge.setu.co). Sandbox first.
SETU_AA_ENV=sandbox                 # sandbox | production (production needs Setu review + Sahamati onboarding)
SETU_AA_BASE_URL=                   # optional override; default https://fiu-sandbox.setu.co or https://fiu.setu.co
SETU_AA_API_PREFIX=/v2
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=
SETU_AA_TOKEN_URL=                  # optional: if your Setu product uses bearer tokens, the token endpoint from Setu
SETU_AA_REDIRECT_URL=http://127.0.0.1:8000/accounts
SETU_AA_WEBHOOK_TOKEN=              # random secret; register .../api/v1/webhooks/aa/setu?token=<value> on Setu Bridge
SETU_AA_CONSENT_MONTHS=12
SETU_AA_HISTORY_DAYS=365

# Optional local, visible bank browser. No API keys or banking passwords required.
# Run once: backend\.venv\Scripts\python.exe -m playwright install chromium
# Enable on the Windows desktop where the customer can see and control the browser.
BROWSER_AUTOMATION_ENABLED=false
BROWSER_LOGIN_TIMEOUT_SECONDS=600
BROWSER_CHANNEL=msedge             # Windows Edge; chromium requires playwright install chromium
